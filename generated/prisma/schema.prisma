// ============================================================
// Smart Parking UBM Tower — Prisma Schema
// ============================================================

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
  output     = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── User ─────────────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  phone        String
  campusId     String?  @map("campus_id")
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  vehicles         Vehicle[]
  membership       Membership?
  payments         Payment[]
  parkingSessions  ParkingSession[]
  slotReservations SlotReservation[]

  @@map("users")
}

// ─── Vehicle — 1 user bisa punya max 3 kendaraan ─────────────────────────────
model Vehicle {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  vehiclePlate String      @map("vehicle_plate")
  vehicleType  VehicleType @map("vehicle_type")
  label        String? // e.g. "Motor Harian", "Mobil Keluarga"
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parkingSessions  ParkingSession[]
  slotReservations SlotReservation[]

  @@unique([userId, vehiclePlate])
  @@index([userId])
  @@map("vehicles")
}

// ─── Parking Zone ─────────────────────────────────────────────────────────────
model ParkingZone {
  id          String   @id @default(uuid())
  name        String
  floorNumber Int      @map("floor_number")
  description String?
  totalSlots  Int      @default(0) @map("total_slots")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  slots ParkingSlot[]

  @@map("parking_zones")
}

// ─── Parking Slot ─────────────────────────────────────────────────────────────
model ParkingSlot {
  id              String      @id @default(uuid())
  zoneId          String      @map("zone_id")
  slotCode        String      @map("slot_code")
  vehicleType     VehicleType @map("vehicle_type")
  status          SlotStatus  @default(AVAILABLE)
  reservedByAdmin Boolean     @default(false) @map("reserved_by_admin")
  reservedNote    String?     @map("reserved_note")
  positionX       Int         @default(0) @map("position_x")
  positionY       Int         @default(0) @map("position_y")
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  zone             ParkingZone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  parkingSessions  ParkingSession[]
  slotReservations SlotReservation[]

  @@unique([zoneId, slotCode])
  @@index([status])
  @@index([vehicleType])
  @@map("parking_slots")
}

// ─── Slot Reservation — user reserve slot, bayar harian, slot prioritas ──────
model SlotReservation {
  id            String            @id @default(uuid())
  userId        String            @map("user_id")
  vehicleId     String            @map("vehicle_id")
  slotId        String            @map("slot_id")
  reserveDate   DateTime          @map("reserve_date") @db.Date // tanggal yang di-reserve
  pricePerDay   Int               @map("price_per_day") // 50000 staff / 35000 student
  status        ReservationStatus @default(PENDING)
  paymentMethod PaymentMethod     @map("payment_method")
  paidAt        DateTime?         @map("paid_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle     @relation(fields: [vehicleId], references: [id])
  slot    ParkingSlot @relation(fields: [slotId], references: [id])

  // 1 slot hanya bisa di-reserve 1 user per hari
  @@unique([slotId, reserveDate])
  @@index([userId])
  @@index([reserveDate])
  @@index([status])
  @@map("slot_reservations")
}

// ─── Parking Session — track posisi kendaraan ────────────────────────────────
model ParkingSession {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  vehicleId    String    @map("vehicle_id")
  slotId       String    @map("slot_id")
  checkedInAt  DateTime  @default(now()) @map("checked_in_at")
  checkedOutAt DateTime? @map("checked_out_at")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle     @relation(fields: [vehicleId], references: [id])
  slot    ParkingSlot @relation(fields: [slotId], references: [id])

  @@index([userId])
  @@index([slotId])
  @@index([checkedOutAt])
  @@map("parking_sessions")
}

// ─── Membership Plan ──────────────────────────────────────────────────────────
model MembershipPlan {
  id            String   @id @default(uuid())
  name          String
  pricePerMonth Int      @map("price_per_month")
  description   String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  memberships Membership[]

  @@map("membership_plans")
}

// ─── Membership — 1 per user, cover semua kendaraan terdaftar ────────────────
model Membership {
  id        String           @id @default(uuid())
  userId    String           @unique @map("user_id") // unique: 1 user 1 membership
  planId    String           @map("plan_id")
  status    MembershipStatus @default(PENDING)
  startDate DateTime         @map("start_date") @db.Date
  endDate   DateTime         @map("end_date") @db.Date
  autoRenew Boolean          @default(false) @map("auto_renew")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     MembershipPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([status])
  @@index([endDate])
  @@map("memberships")
}

// ─── Payment ──────────────────────────────────────────────────────────────────
model Payment {
  id              String        @id @default(uuid())
  membershipId    String        @map("membership_id")
  userId          String        @map("user_id")
  amount          Int
  paymentMethod   PaymentMethod @map("payment_method")
  status          PaymentStatus @default(PENDING)
  paymentProofUrl String?       @map("payment_proof_url")
  paidAt          DateTime?     @map("paid_at")
  periodStart     DateTime      @map("period_start") @db.Date
  periodEnd       DateTime      @map("period_end") @db.Date
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@index([membershipId])
  @@index([status])
  @@map("payments")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  STUDENT // mahasiswa — reserve Rp35.000/hari
  STAFF // karyawan  — reserve Rp50.000/hari
  ADMIN

  @@map("role")
}

enum VehicleType {
  MOTOR
  MOBIL

  @@map("vehicle_type")
}

enum SlotStatus {
  AVAILABLE
  OCCUPIED
  RESERVED // di-reserve admin (permanent)
  MAINTENANCE

  @@map("slot_status")
}

enum ReservationStatus {
  PENDING // belum bayar
  ACTIVE // sudah bayar, slot diprioritaskan untuk user ini
  CANCELLED
  EXPIRED // tanggal reserve sudah lewat

  @@map("reservation_status")
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  PENDING
  CANCELLED

  @@map("membership_status")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum PaymentMethod {
  TRANSFER
  VIRTUAL_ACCOUNT
  QRIS

  @@map("payment_method")
}
